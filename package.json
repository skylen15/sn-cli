{
  "name": "sn",
  "version": "3.0.0",
  "description": "ServiceNow from the command line",
  "type": "module",
  "author": "Khoi Bui",
  "license": "MIT",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "sn": "./src/cli.ts"
  },
  "imports": {
    "#src/*": "./src/*",
    "#package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"tests/cli/**/*.test.ts\" \"tests/servicenow/**/*.test.ts\"",
    "check": "pnpm run typecheck && pnpm run format:check && pnpm run lint && pnpm run test",
    "now-sdk:auth": "node node_modules/@servicenow/sdk/bin/index.js auth"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.109",
    "@servicenow/sdk": "^4.7.2",
    "@servicenow/sdk-cli": "^4.7.2",
    "effect": "4.0.0-rc.109"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "eslint": "^10.5.0",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  }
}
