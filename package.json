{
  "name": "sn",
  "version": "4.0.0",
  "description": "ServiceNow from the command line",
  "license": "MIT",
  "author": "Khoi Bui",
  "repository": {
    "type": "git",
    "url": "https://github.com/skylen15/sn-cli.git"
  },
  "bin": {
    "sn": "./src/cli.ts"
  },
  "type": "module",
  "imports": {
    "#src/*": "./src/*",
    "#package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "node --test \"tests/cli/**/*.test.ts\" \"tests/servicenow/**/*.test.ts\" \"tests/*.test.ts\"",
    "check": "pnpm run typecheck && pnpm run fmt:check && pnpm run lint && pnpm run test"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.109",
    "@servicenow/sdk": "^4.7.2",
    "@servicenow/sdk-cli": "^4.7.2",
    "effect": "4.0.0-rc.109",
    "oxfmt": "0.64.0"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.81.0",
    "@types/node": "^26.0.0",
    "oxfmt": "0.64.0",
    "oxlint": "1.81.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.20.0"
}
